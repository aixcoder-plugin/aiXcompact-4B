+import { describe, expect, test } from "bun:test"
+import { Config } from "../../src/config/config"
+
+describe("compaction config", () => {
+  test.each([1, 10, 25, 50, 99])("accepts target_ratio_pct=%d", (targetRatioPct) => {
+    const config = Config.Info.zod.parse({
+      compaction: { target_ratio_pct: targetRatioPct },
+    })
+
+    expect(config.compaction?.target_ratio_pct).toBe(targetRatioPct)
+  })
+
+  test.each([0, 100, 25.5])("rejects target_ratio_pct=%s", (targetRatioPct) => {
+    expect(() =>
+      Config.Info.zod.parse({
+        compaction: { target_ratio_pct: targetRatioPct },
+      }),
+    ).toThrow()
+  })
+
+  test("keeps target_ratio_pct optional so the runtime default remains 25", () => {
+    const config = Config.Info.zod.parse({ compaction: {} })
+
+    expect(config.compaction?.target_ratio_pct).toBeUndefined()
+  })
+})
