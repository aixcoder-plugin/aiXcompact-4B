new file mode 100644
index 0000000..bd583f1
--- /dev/null
+++ b/packages/opencode/test/session/compaction-cancel.test.ts
@@ -0,0 +1,96 @@
+import { describe, expect, test } from "bun:test"
+import { createCompactionCanceller } from "../../src/session/compaction-cancel"
+
+describe("external compaction cancellation", () => {
+  test("does not call cancel before an interrupt or timeout", () => {
+    let calls = 0
+    const canceller = createCompactionCanceller({
+      cancelUrl: "http://compaction.test/cancel/normal",
+      requestController: new AbortController(),
+      fetchFn: async () => {
+        calls++
+        return new Response("{}", { status: 200 })
+      },
+    })
+
+    expect(canceller.pending()).toBeUndefined()
+    expect(calls).toBe(0)
+  })
+
+  test("aborts the compact request and acknowledges cancel exactly once", async () => {
+    const requestController = new AbortController()
+    const reason = new DOMException("user stopped", "AbortError")
+    const calls: Array<{ url: string; signal: AbortSignal | null }> = []
+    const canceller = createCompactionCanceller({
+      cancelUrl: "http://compaction.test/cancel/request-1",
+      requestController,
+      fetchFn: async (url, init) => {
+        calls.push({ url: String(url), signal: init?.signal ?? null })
+        return new Response('{"cancelled":true}', { status: 200 })
+      },
+    })
+
+    const first = canceller.cancel("interrupt", reason)
+    const second = canceller.cancel("timeout", new DOMException("late timeout", "TimeoutError"))
+
+    expect(first).toBe(second)
+    expect(requestController.signal.aborted).toBe(true)
+    expect(requestController.signal.reason).toBe(reason)
+    const result = await first
+    expect(result).toMatchObject({ trigger: "interrupt", outcome: "cancelled", httpStatus: 200 })
+    expect(calls).toHaveLength(1)
+    expect(calls[0]?.url).toBe("http://compaction.test/cancel/request-1")
+    expect(calls[0]?.signal).not.toBe(requestController.signal)
+  })
+
+  test("treats 404 as an already completed or unregistered request", async () => {
+    const canceller = createCompactionCanceller({
+      cancelUrl: "http://compaction.test/cancel/finished",
+      requestController: new AbortController(),
+      fetchFn: async () => new Response('{"detail":"not found"}', { status: 404 }),
+    })
+
+    await expect(canceller.cancel("interrupt")).resolves.toMatchObject({
+      outcome: "not_found",
+      httpStatus: 404,
+    })
+  })
+
+  test("reports a non-404 server failure without throwing", async () => {
+    const canceller = createCompactionCanceller({
+      cancelUrl: "http://compaction.test/cancel/failure",
+      requestController: new AbortController(),
+      fetchFn: async () => new Response("unavailable", { status: 503 }),
+    })
+
+    await expect(canceller.cancel("timeout")).resolves.toMatchObject({
+      trigger: "timeout",
+      outcome: "failed",
+      httpStatus: 503,
+    })
+  })
+
+  test("bounds an unresponsive cancel request with an independent timeout", async () => {
+    const requestController = new AbortController()
+    let cancelSignal: AbortSignal | undefined
+    const canceller = createCompactionCanceller({
+      cancelUrl: "http://compaction.test/cancel/slow",
+      requestController,
+      cancelTimeout: 10,
+      fetchFn: async (_url, init) => {
+        cancelSignal = init?.signal ?? undefined
+        return await new Promise<Response>((_resolve, reject) => {
+          cancelSignal?.addEventListener("abort", () => reject(cancelSignal?.reason), { once: true })
+        })
+      },
+    })
+
+    const result = await canceller.cancel("interrupt", new DOMException("stop", "AbortError"))
+
+    expect(requestController.signal.aborted).toBe(true)
+    expect(cancelSignal).not.toBe(requestController.signal)
+    expect(cancelSignal?.aborted).toBe(true)
+    expect(result.outcome).toBe("failed")
+    expect(result.detail).toContain("TimeoutError")
+  })
+})
