diff --git a/packages/opencode/src/session/compaction-cancel.ts b/packages/opencode/src/session/compaction-cancel.ts
new file mode 100644
index 0000000..a46a189
--- /dev/null
+++ b/packages/opencode/src/session/compaction-cancel.ts
@@ -0,0 +1,61 @@
+export const DEFAULT_COMPACTION_CANCEL_TIMEOUT = 5_000
+
+export type CompactionCancelTrigger = "interrupt" | "timeout"
+
+export type CompactionCancelResult = {
+  trigger: CompactionCancelTrigger
+  outcome: "cancelled" | "not_found" | "failed"
+  httpStatus?: number
+  detail?: string
+}
+
+type FetchLike = (input: RequestInfo | URL, init?: RequestInit) => Promise<Response>
+
+export function createCompactionCanceller(input: {
+  cancelUrl: string
+  requestController: AbortController
+  fetchFn?: FetchLike
+  cancelTimeout?: number
+}) {
+  const fetchFn = input.fetchFn ?? fetch
+  const cancelTimeout = input.cancelTimeout ?? DEFAULT_COMPACTION_CANCEL_TIMEOUT
+  let pending: Promise<CompactionCancelResult> | undefined
+
+  const notifyService = async (trigger: CompactionCancelTrigger): Promise<CompactionCancelResult> => {
+    const cancelController = new AbortController()
+    const timer = setTimeout(
+      () => cancelController.abort(new DOMException(`cancel timeout after ${cancelTimeout}ms`, "TimeoutError")),
+      cancelTimeout,
+    )
+    try {
+      const response = await fetchFn(input.cancelUrl, {
+        method: "POST",
+        signal: cancelController.signal,
+      })
+      const detail = await response.text().catch(() => "")
+      if (response.ok) return { trigger, outcome: "cancelled", httpStatus: response.status, detail }
+      if (response.status === 404) return { trigger, outcome: "not_found", httpStatus: 404, detail }
+      return { trigger, outcome: "failed", httpStatus: response.status, detail }
+    } catch (error) {
+      return {
+        trigger,
+        outcome: "failed",
+        detail: error instanceof Error ? `${error.name}: ${error.message}` : String(error),
+      }
+    } finally {
+      clearTimeout(timer)
+    }
+  }
+
+  return {
+    cancel(trigger: CompactionCancelTrigger, reason?: unknown) {
+      if (pending) return pending
+      pending = notifyService(trigger)
+      if (!input.requestController.signal.aborted) input.requestController.abort(reason)
+      return pending
+    },
+    pending() {
+      return pending
+    },
+  }
+}
