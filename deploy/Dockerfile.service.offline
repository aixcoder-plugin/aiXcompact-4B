ARG PYTHON_BASE_IMAGE=python:3.12-slim
FROM ${PYTHON_BASE_IMAGE}
WORKDIR /app
COPY wheels /wheels
COPY service/requirements.txt /app/requirements.txt
RUN pip install --no-index --find-links=/wheels --target=/opt/compact-deps -r requirements.txt
COPY service /app/service
ENV PYTHONPATH=/opt/compact-deps COMPACTION_HOST=0.0.0.0 COMPACTION_PORT=12003
EXPOSE 12003
ENTRYPOINT []
CMD ["python3", "-m", "service.main"]
